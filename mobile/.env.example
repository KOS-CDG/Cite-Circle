# FastAPI backend (see /backend, deployed on Render)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (anon/public key only — never put the service-role key in a client bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary (unsigned upload preset for client-side uploads)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
